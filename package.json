{
  "name": "registro-br-mcp",
  "version": "1.0.0",
  "description": "MCP Server para consultar o RDAP do Registro.br",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "registro-br-mcp": "./src/index.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "node src/index.js",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rdap",
    "registro.br",
    "whois",
    "domain",
    "brasil",
    "brazil"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yvesmariano/registro-br-mcp.git"
  },
  "author": "Yves Mariano",
  "homepage": "https://github.com/yvesmariano/registro-br-mcp#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.8"
  }
}
